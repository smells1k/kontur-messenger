@echo off
chcp 65001 >nul
title Контур — подключение к серверу друга
echo.
echo   МЕССЕНДЖЕР «КОНТУР» — ПОДКЛЮЧЕНИЕ К СЕРВЕРУ ДРУГА
echo   ==============================================
echo.
echo   Введите адрес сервера, который вам дал друг.
echo   Обычно он выглядит так:  http://192.168.1.10:4000
echo   (этот адрес друг видит в чёрном окне своего сервера)
echo.
set /p addr="  Адрес сервера: "
if "%addr%"=="" (
  echo   Адрес не введён — выходим.
  pause
  exit /b 1
)

set EXE=%~dp0KonturServer.exe
if not exist "%EXE%" (
  echo   Не найден KonturServer.exe рядом с этим файлом.
  pause
  exit /b 1
)

echo.
echo   Подключаюсь к %addr% ...
echo   Откроется окно мессенджера. Камера, микрофон и демонстрация экрана
echo   в нём работают — разрешения уже выданы.
echo.
start "" "%EXE%" --server %addr%
exit /b 0
